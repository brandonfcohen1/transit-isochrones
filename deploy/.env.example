# Copy to .env in this directory and fill in.
# .env is gitignored — the secrets stay on the server.

# Public HTTPS URL of the packed MOTIS dataset (dist/motis-dataset.tar.gz)
# uploaded to object storage. The bootstrap script downloads this on first
# container boot. Cloudflare R2 with a public bucket is the cheap default.
MOTIS_DATASET_URL=https://your-bucket.r2.dev/motis-dataset.tar.gz

# Optional. Without it the app uses demotiles.maplibre.org (visibly low-fi).
# MapTiler free tier covers a hobby project comfortably.
# NEXT_PUBLIC_MAPTILER_KEY=

# Optional. Caps in-flight MOTIS calls per process. Default 8 for a CPX11.
# MOTIS_CONCURRENCY=8
