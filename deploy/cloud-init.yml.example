#cloud-config
# Hetzner cloud-init for the SEPTA isochrone single-box deploy.
# Paste this into the "Cloud config" field when creating the server
# (Hetzner Cloud console: Servers → Create → User data).
#
# Provisions, in order:
#   - 2 GB swap so the Next.js production build doesn't OOM on a 2 GB box
#   - Docker + the compose plugin (official convenience script)
#   - ufw allowing 22 (ssh) / 80 (http) / 443 (https), everything else denied
#   - A non-root `deploy` user; root login is disabled
#
# Cloud-init runs in the background; the box is reachable on ssh in
# ~30 s, but full provisioning takes ~3-5 min. Tail /var/log/cloud-init-output.log
# if you want to watch.
#
# After cloud-init finishes:
#   ssh deploy@<server-ip>
#   git clone <your-fork-url> septa-iso && cd septa-iso/deploy
#   cp .env.example .env && $EDITOR .env   # fill in MOTIS_DATASET_URL + domain
#   docker compose -f docker-compose.prod.yml up -d --build

users:
  - name: deploy
    groups: [docker, sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      # REPLACE with your public key — `cat ~/.ssh/id_ed25519.pub` (or id_rsa.pub).
      # Without this you'll be locked out: root login is disabled below.
      - ssh-ed25519 AAAA...REPLACE_ME your-email@host

ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - ufw
  - git
  - htop

write_files:
  - path: /etc/sysctl.d/99-swappiness.conf
    content: |
      vm.swappiness=10

runcmd:
  # Swap. CPX11 has 2 GB RAM; the Next.js build peaks around 1.5-2 GB.
  # Without swap, the build OOMs. With swap it falls through gracefully.
  - fallocate -l 2G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - sysctl -p /etc/sysctl.d/99-swappiness.conf

  # Docker via the official convenience script. Pulls the latest stable
  # docker-ce + the compose plugin in one step.
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker

  # Firewall: deny everything inbound except ssh + Caddy's :80 and :443.
  # MOTIS (8080) and Next.js (3000) stay private to the docker network.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

  # Optional: enable unattended security updates so you don't have to
  # apt upgrade by hand for kernel CVEs.
  - apt-get install -y unattended-upgrades
  - dpkg-reconfigure -plow unattended-upgrades
